/* HakiOS's U-Boot on the OPPO Reno Ace (pclm10): board/qualcomm/qcom-phone.env with HakiOS's boot first */
bootdelay=0
bootretry=1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

fastboot=fastboot -l $fastboot_addr_r usb 0

/*
 * The USB gadget's fastboot status (lib/efi_loader/efi_qcom_usb.c) prints every host command and every
 * upload's progress, marked [oosexgang], onto the panel. While the HakiOS loader runs a kernel that is the
 * system's screen: the loader keeps its own text out of it (screen_quiet), but the driver's lines came
 * through the text console anyway, over the system's picture - the home screen drawn at 13:57 was covered
 * by "host: upload" and "30% 50% 80%" from the payload's upload. The host sees the same in its fastboot
 * output, so the panel stays the system's. (It is on again with "setenv hakios_status 1" from the shell.)
 */
hakios_status=0

/* UFS: the HakiOS loader reads its partitions (logdump, darwin) through U-Boot's block devices */
preboot=scsi scan

/*
 * The HakiOS loader and its payload from memory: from the boot image's ramdisk when ABL brought one, else from the
 * host over fastboot (hakios_fastboot). Nothing is written to the phone's storage on the way.
 */
bootcmd=if hakios load; then hakios boot; fi; run hakios_fastboot
hakios_fastboot=echo; echo "HakiOS: waiting for the host:"; \
	echo "  fastboot stage x.hkub"; \
	echo "  fastboot oem run:hakios load fastboot"; \
	echo "  fastboot continue"; \
	setenv bootretry -1; run fastboot; hakios boot; pause; run menucmd

serial_gadget=setenv stdin serial,button-kbd,usbacm; \
	setenv stdout serial,vidconsole,usbacm; \
	setenv stderr serial,vidconsole,usbacm; \
	setenv bootretry -1; \
	echo Enabled U-Boot console serial gadget

menucmd=setenv bootcmd run menucmd; bootmenu -1

bootmenu_0=HakiOS (from memory)=hakios load; hakios boot; pause
bootmenu_1=HakiOS over fastboot=run hakios_fastboot
bootmenu_2=Enable serial console gadget=run serial_gadget
bootmenu_3=Enable fastboot mode=run fastboot
bootmenu_4=What is in memory=hakios info; pause
bootmenu_5=Drop to shell=setenv bootretry -1
bootmenu_6=Reset device=reset
bootmenu_7=Board info=bdinfo; meminfo; pause

/* hold volume down while U-Boot starts: the menu instead of HakiOS */
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
