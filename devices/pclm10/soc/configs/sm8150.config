# HakiOS fragment: the sm8150 family -- what is true of the SoC, whatever device it is in.
# The processor has eight cores (four Kryo 485 Silver, three Gold, one Prime) and the biggest is core 7;
# the kernel gets seven of them, because the boot loader keeps the core it is running on for itself
# (xnuloader/loader.c:3390 skips its own core). Seven answered on the Reno Ace with no psci failure
# (logs/010909-run.log: "7 processors running").
CONFIG_SOC="sm8150"
CONFIG_CPUS=8
CONFIG_BOOTCPU=7
# The clock: three EPSS groups at 0x18323000, 0x18325800 and 0x18327800 (mainline sm8150.dtsi's
# cpufreq@18323000), the older register layout of Linux's qcom_soc_data -- the frequency rows at
# +0x110, 32 bytes apart with the supply voltage next to each, and the row wanted asked for at
# +0x920 (epss_hw=1 says the layout; the reference phone's newer one needs nothing). The firmware
# fills the rows with its own frequencies and voltages and leaves the clock low -- a read-only round
# found 300-1785, 710-2419 and 825-2956 MHz in place and the prime at 825 (logs/013517-run.log) --
# so the driver's whole job is to ask each group for the top row of the table it was given. That is
# worth 3.6x on one core (logs/013949-run.log: a loop on core 7, 149 -> 536), and the memory
# bandwidth vote that goes with it (the driver's default) went through RPMh (logs/015951-run.log).
CONFIG_CPUFREQ=y
CONFIG_EPSS_HW=y
CONFIG_EPSS0=0x18323000
CONFIG_EPSS1=0x18325800
CONFIG_EPSS2=0x18327800
# the drivers of this SoC family: a device with it gets them from here, whatever phone-specific drivers it leaves out
CONFIG_HAKIOS_CPUFREQ=y
